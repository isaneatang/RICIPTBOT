# ============================================================================
# RICIPT environment configuration
# ============================================================================
# Copy this file to `.env` and fill in the values.
#
# IMPORTANT — public vs secret:
#
#   VITE_*  => PUBLIC. Bundled into the browser by Vite. Anyone can read them.
#              This is fine for a chain ID / RPC URL / contract address /
#              Reown project ID (they are all public by nature).
#
#   DEPLOYER_PRIVATE_KEY => SECRET. Used ONLY by hardhat during `deploy:*`.
#              It is NOT a VITE_ variable and is never bundled into the app.
#              Never commit this value. It belongs in .env (git-ignored) and
#              ideally only on your local machine / a CI secret store.

# --- Reown / WalletConnect ------------------------------------------------
# Create a free project at https://dashboard.reown.com and paste the Project ID.
# This is public — AppKit ships it to the browser by design.
VITE_REOWN_PROJECT_ID=YOUR_REOWN_PROJECT_ID

# --- Smart contract addresses (deployed on BOT Chain) ----------------------
# After running `npm run deploy:testnet`, paste the printed address here.
# Leave blank/YOUR_TESTNET_CONTRACT_ADDRESS until then — the app will show a
# clear "contract not configured" message instead of failing silently.
VITE_TESTNET_CONTRACT_ADDRESS=YOUR_TESTNET_CONTRACT_ADDRESS
VITE_MAINNET_CONTRACT_ADDRESS=YOUR_MAINNET_CONTRACT_ADDRESS

# --- Secret (never put this in the browser) --------------------------------
# Used by `npm run deploy:testnet` / `npm run deploy:mainnet` via hardhat.
# 0x + 64 hex chars, no leading 0x is also accepted by hardhat.
DEPLOYER_PRIVATE_KEY=YOUR_DEPLOYER_PRIVATE_KEY