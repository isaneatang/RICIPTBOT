{
  "name": "ricipt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RICIPT - blockchain-backed device provenance/passport app for BOT Chain",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "compile": "node scripts/compile-contract.js",
    "deploy:testnet": "hardhat run deploy/deploy.cjs --network botChainTestnet",
    "deploy:mainnet": "hardhat run deploy/deploy.cjs --network botChainMainnet",
    "compile:contract": "hardhat compile"
  },
  "dependencies": {
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@tanstack/react-query": "^5.59.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "viem": "^2.55.19",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@openzeppelin/contracts": "5.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.18",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "keccak@3.0.4": true,
    "bufferutil@4.1.0": true,
    "utf-8-validate@5.0.10": true,
    "@reown/appkit@1.8.23": true,
    "@reown/appkit@1.7.8": true
  }
}
